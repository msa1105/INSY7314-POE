{
  "name": "hustlehub-backend",
  "version": "1.0.0",
  "description": "HustleHub+ Secure Freelance Marketplace Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "generate-certs": "node generate-certs.js",
    "test": "cross-env NODE_ENV=test jest --coverage --forceExit",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "lint": "eslint src/ tests/ --ext .js"
  },
  "keywords": ["freelance", "marketplace", "api", "secure", "nodejs", "express", "jwt"],
  "author": "HustleHub+ Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "selfsigned": "^2.4.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
