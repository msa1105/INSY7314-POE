# ============================================================
# HustleHub+ Backend – Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=replace_with_a_long_random_secret_min_64_chars
JWT_EXPIRES_IN=1h

# HTTPS / SSL Paths (relative to backend root)
SSL_KEY_PATH=./ssl/server.key
SSL_CERT_PATH=./ssl/server.cert

# CORS – Allowed frontend origin
CORS_ORIGIN=https://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Bcrypt salt rounds (10-12 is recommended; higher = more secure but slower)
BCRYPT_SALT_ROUNDS=12
