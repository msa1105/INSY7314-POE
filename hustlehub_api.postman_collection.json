{
  "info": {
    "_postman_id": "hustlehub-part1-collection",
    "name": "HustleHub+ API – Part 1",
    "description": "Postman collection for HustleHub+ Part 1 – Secure Backend Foundations.\n\nCovers:\n- User registration (client and freelancer)\n- Login with token generation\n- Protected profile route\n- Invalid/edge-case scenarios\n- Gig management (freelancer RBAC)\n\nBase URL variable: {{baseUrl}} = https://localhost:5000\nToken variable: {{token}} – automatically set by the Login request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:5000", "type": "string" },
    { "key": "token",   "value": "",                       "type": "string" }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status ok', () => { const j = pm.response.json(); pm.expect(j.status).to.eql('ok'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register – Valid Client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Dlamini\",\n  \"email\": \"alice@hustlehub.test\",\n  \"password\": \"SecurePass1!\",\n  \"role\": \"client\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Token returned', () => { const j = pm.response.json(); pm.expect(j).to.have.property('token'); });",
                  "pm.test('No passwordHash exposed', () => { const j = pm.response.json(); pm.expect(j.user).to.not.have.property('passwordHash'); });",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register – Valid Freelancer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Nkosi\",\n  \"email\": \"bob@hustlehub.test\",\n  \"password\": \"FreelanceR9@\",\n  \"role\": \"freelancer\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Role is freelancer', () => { pm.expect(pm.response.json().user.role).to.eql('freelancer'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register – Duplicate Email (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Dlamini\",\n  \"email\": \"alice@hustlehub.test\",\n  \"password\": \"SecurePass1!\",\n  \"role\": \"client\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "pm.test('Has error field', () => pm.expect(pm.response.json()).to.have.property('error'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register – Weak Password (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@hustlehub.test\",\n  \"password\": \"weak\",\n  \"role\": \"client\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "pm.test('Fields array present', () => pm.expect(pm.response.json()).to.have.property('fields'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register – Invalid Email (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"not-an-email\",\n  \"password\": \"SecurePass1!\",\n  \"role\": \"client\"\n}"
            }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status 422', () => pm.response.to.have.status(422));"] } }
          ]
        },
        {
          "name": "Login – Valid Credentials",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@hustlehub.test\",\n  \"password\": \"SecurePass1!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token returned', () => pm.expect(pm.response.json()).to.have.property('token'));",
                  "pm.test('No passwordHash exposed', () => pm.expect(pm.response.json().user).to.not.have.property('passwordHash'));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login – Wrong Password (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@hustlehub.test\",\n  \"password\": \"WrongPassword9!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Generic error message', () => pm.expect(pm.response.json().error).to.eql('Invalid email or password.'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login – Unknown Email (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ghost@hustlehub.test\",\n  \"password\": \"DoesntMatter1!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Generic message (no user enumeration)', () => pm.expect(pm.response.json().error).to.eql('Invalid email or password.'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Protected Routes",
      "item": [
        {
          "name": "GET /api/users/profile – With Token",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/profile", "host": ["{{baseUrl}}"], "path": ["api", "users", "profile"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('User object returned', () => pm.expect(pm.response.json()).to.have.property('user'));",
                  "pm.test('No passwordHash', () => pm.expect(pm.response.json().user).to.not.have.property('passwordHash'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/users/profile – No Token (401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/profile", "host": ["{{baseUrl}}"], "path": ["api", "users", "profile"] }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"] } }
          ]
        },
        {
          "name": "GET /api/users/profile – Invalid Token (401)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer this.is.not.a.real.token" }],
            "url": { "raw": "{{baseUrl}}/api/users/profile", "host": ["{{baseUrl}}"], "path": ["api", "users", "profile"] }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"] } }
          ]
        }
      ]
    },
    {
      "name": "Gigs (Freelancer)",
      "item": [
        {
          "name": "POST /api/gigs – Create Gig (freelancer token required)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/gigs", "host": ["{{baseUrl}}"], "path": ["api", "gigs"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Professional Logo Design\",\n  \"description\": \"I will create a stunning logo for your brand.\",\n  \"price\": 500,\n  \"category\": \"Design\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 (freelancer) or 403 (client)', () => {",
                  "  pm.expect([201, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/gigs – List All Gigs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/gigs", "host": ["{{baseUrl}}"], "path": ["api", "gigs"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Gigs array present', () => pm.expect(pm.response.json()).to.have.property('gigs'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
